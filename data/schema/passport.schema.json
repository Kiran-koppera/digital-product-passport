{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiran-koppera.github.io/digital-product-passport/data/schema/passport.schema.json",
  "title": "Battery Digital Product Passport record",
  "description": "One battery passport record. Sections follow the eight attribute categories defined in the project report (section 4.3). A field value of null means the attribute is defined in the data model but not yet populated.",
  "type": "object",
  "required": ["id", "uid", "productName", "recordStatus", "sections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "URL slug; encoded in the QR code as passport.html?id=<id>" },
    "uid": { "type": ["string", "null"], "description": "Unique product identifier (see docs/data-model.md#unique-identifier)" },
    "productName": { "type": "string", "minLength": 1 },
    "recordStatus": { "enum": ["documented", "placeholder"], "description": "documented: populated passport record; placeholder: structure only" },
    "source": { "type": "string" },
    "legacyQr": { "type": "string", "format": "uri", "description": "Original (now deactivated) dynamic QR short link" },
    "sections": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["key", "title", "access", "fields"],
        "additionalProperties": false,
        "properties": {
          "key": {
            "enum": ["product-identification", "material-composition", "manufacturing-data", "technical-data", "environmental-impact", "circularity", "supply-chain", "compliance"]
          },
          "title": { "type": "string" },
          "access": { "enum": ["public", "restricted"] },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "value": {
                  "oneOf": [
                    { "type": "null" },
                    { "type": "string", "minLength": 1 },
                    { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
                  ]
                },
                "format": { "enum": ["mono", "date"] },
                "note": { "type": "string" },
                "link": {
                  "type": "object",
                  "required": ["text", "href"],
                  "additionalProperties": false,
                  "properties": { "text": { "type": "string" }, "href": { "type": "string", "format": "uri" } }
                }
              }
            }
          }
        }
      }
    }
  }
}
